{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selfcommunication.event.v0.1-candidate.schema.json",
  "title": "SELFCommunicationEvent v0.1 Candidate",
  "description": "Candidate-only local witness contract. This is not a ratified canonical schema.",
  "type": "object",
  "required": [
    "schema",
    "event_id",
    "artifact_status",
    "created_at",
    "source_actor_ref",
    "target_actor_ref",
    "matter_ref",
    "darkmatterbox",
    "observation_identity",
    "admission_identity",
    "authority_identity",
    "effect_identity",
    "trajectory",
    "reality_dispositions",
    "ack",
    "hollaback",
    "non_collapse",
    "authority_ceiling",
    "witness_refs",
    "relation_refs",
    "residue_refs",
    "reconciliation_status"
  ],
  "properties": {
    "schema": {
      "const": "selfcommunication.event.v0.1-candidate"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_status": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "source_actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "target_actor_ref": {
      "type": "string",
      "minLength": 1
    },
    "matter_ref": {
      "type": "object",
      "required": ["matter_id", "content", "encoding", "identity", "expression_identity", "manifestation"],
      "properties": {
        "matter_id": { "type": "string" },
        "content": { "type": "string" },
        "encoding": { "const": "utf8" },
        "identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "expression_identity": {
          "type": "object",
          "required": ["sha256", "byte_length", "encoding"],
          "properties": {
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "byte_length": { "type": "integer", "minimum": 0 },
            "encoding": { "const": "utf8" }
          }
        },
        "manifestation": {
          "type": "array",
          "items": {
            "enum": ["linguistic", "structural", "behavioral", "evidentiary", "visual", "stateful"]
          },
          "minItems": 1
        }
      }
    },
    "darkmatterbox": {
      "type": "object",
      "required": [
        "box_id",
        "role",
        "status",
        "possible_interpretations",
        "actual_observation_ref",
        "admitted_variant_ref",
        "rejected_variant_refs"
      ],
      "properties": {
        "box_id": { "type": "string" },
        "role": { "const": "BOUNDED_POSSIBILITY_CHAMBER" },
        "status": { "enum": ["ENTERED", "OBSERVED", "ADMITTED", "RECONCILED"] },
        "possible_interpretations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["variant_id", "disposition", "content", "identity", "derivation"],
            "properties": {
              "variant_id": { "type": "string" },
              "disposition": { "enum": ["POSSIBLE", "OBSERVED", "ADMITTED", "REJECTED"] },
              "content": { "type": "string" },
              "identity": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
              "derivation": { "type": "string" }
            }
          }
        },
        "actual_observation_ref": { "type": "string" },
        "admitted_variant_ref": { "type": ["string", "null"] },
        "rejected_variant_refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "trajectory": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["stage", "disposition", "identity_ref"],
        "properties": {
          "stage": {
            "enum": ["EXPRESSED", "TRANSMITTED", "OBSERVED", "UNDERSTOOD", "ADMITTED", "AUTHORIZED", "EFFECTED"]
          },
          "disposition": {
            "enum": ["POSSIBLE", "OBSERVED", "ESTABLISHED", "ADMITTED", "AUTHORIZED", "EFFECTED", "BLOCKED", "NOT_APPLICABLE"]
          },
          "identity_ref": { "type": ["string", "null"] },
          "note": { "type": "string" }
        }
      }
    },
    "ack": {
      "type": "object",
      "required": ["ack_id", "kind", "claim", "observed_matter_identity", "authority_disposition", "proof_disposition"],
      "properties": {
        "ack_id": { "type": "string" },
        "kind": { "const": "ACK" },
        "claim": { "const": "WHAT_I_RECEIVED" },
        "observed_matter_identity": { "type": "string" },
        "authority_disposition": { "const": "NONE" },
        "proof_disposition": { "const": "NOT_PROOF_OF_AUTHORITY" }
      }
    },
    "hollaback": {
      "type": "object",
      "required": ["hollaback_id", "kind", "claim", "effect_ref", "effect_disposition", "proof_disposition"],
      "properties": {
        "hollaback_id": { "type": "string" },
        "kind": { "const": "HOLLABACK" },
        "claim": { "const": "WHAT_HAPPENED_BECAUSE_OF_IT" },
        "effect_ref": { "type": ["string", "null"] },
        "effect_disposition": { "type": "string" },
        "proof_disposition": { "const": "NOT_PROOF_OF_ACK" }
      }
    }
  }
}
